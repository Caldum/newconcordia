{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "concordia-clock",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  // 00:00 UTC: the game day changes (business time is UTC, ADR 0014).
  "triggers": { "crons": ["0 0 * * *", "0 * * * *", "5 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  // Local default. Deployments pass the project URL with `--var SUPABASE_URL:...`.
  "vars": { "SUPABASE_URL": "http://127.0.0.1:54321" },
  "secrets": { "required": ["SUPABASE_SECRET_KEY"] },
  "env": {
    "staging": {
      "name": "concordia-clock-staging",
      "vars": { "SUPABASE_URL": "http://127.0.0.1:54321" },
      "secrets": { "required": ["SUPABASE_SECRET_KEY"] },
    },
  },
}
