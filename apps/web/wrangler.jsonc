{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "concordia-web",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "env": {
    "staging": {
      "name": "concordia-web-staging",
    },
  },
}
