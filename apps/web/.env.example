# Copy to .env.local for `pnpm dev` against local Supabase (`pnpm db:start`, then `supabase status`).
# Only public values: the URL and the publishable key. Never put a secret key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_from_supabase_status
# Cloudflare's Turnstile test site key (always passes). Each environment uses its own real key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Set to true once Google is configured for the Supabase project (docs/setup.md).
VITE_GOOGLE_SIGN_IN=false
