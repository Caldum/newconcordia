{
  "name": "concordia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.28.0 <11"
  },
  "scripts": {
    "lint": "pnpm lint:es && pnpm lint:format",
    "lint:es": "eslint . --max-warnings 0 --cache",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:native": "node supabase/scripts/run-native-tests.js",
    "db:lint": "squawk supabase/migrations/*.sql",
    "db:types": "supabase gen types typescript --local --schema public > packages/db-types/src/database.ts && prettier --write packages/db-types/src/database.ts",
    "db:types:native": "supabase gen types typescript --db-url \"postgresql://postgres:postgres@127.0.0.1:5432/concordia_test?sslmode=disable\" --schema public > packages/db-types/src/database.ts && prettier --write packages/db-types/src/database.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "squawk-cli": "2.68.0",
    "supabase": "2.120.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
